#!/bin/sh
# Installed into every clone of this repo by `python scripts/train.py hooks`.
#
# 1. Only the release train publishes. A push to main is refused unless the
#    train is doing it (RELEASE_TRAIN=1) or Avi overrides in an emergency
#    (RELEASE_TRAIN_OVERRIDE=1). Pushes to other branches are allowed: that
#    is how the mail bot hands its work to the train, and Render deploys only
#    main. docs/procedures/release_train.md.
# 2. Nothing reaches main while a post-mortem has not reached FullStackBKM
#    (CLAUDE.md, "Every lesson goes back to FullStackBKM").
to_main=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then to_main=1; fi
done
[ "$to_main" = "1" ] || exit 0
if [ -z "$RELEASE_TRAIN" ] && [ -z "$RELEASE_TRAIN_OVERRIDE" ]; then
  echo "Push to main refused: only the release train publishes."
  echo "Ask it instead:  python scripts/train.py ship --app <app> --run --wait 3600"
  echo "Board: C:\Users\avisa\.claude\release-train\board.md"
  exit 1
fi
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/env/Scripts/python.exe"
[ -x "$PY" ] || PY="$ROOT/env/bin/python"
[ -f "$ROOT/scripts/bkm_drift.py" ] || exit 0
exec "$PY" "$ROOT/scripts/bkm_drift.py" --gate
