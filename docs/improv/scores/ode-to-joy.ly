% Ode to Joy: the theme from the last movement of Beethoven's Ninth Symphony (1824), public domain.
% The right hand is the tune. The left hand is a plain two-chord bass written for improv (one note a bar),
% so it is not Beethoven's and the piece is marked as an AI draft until Avi has played it.
rh = \relative c' {
  \time 4/4
  \key c \major
  e4 e f g | g f e d | c c d e | e4. d8 d2 |
  e4 e f g | g f e d | c c d e | d4. c8 c2 |
  d4 d e c | d e8 f e4 c | d e8 f e4 d | c d g,2 |
  e'4 e f g | g f e d | c c d e | d4. c8 c2 |
}

lh = \relative c {
  \time 4/4
  \key c \major
  c1 | g | c | g |
  c1 | g | c | g2 c |
  g1 | c | g | c2 g |
  c1 | g | c | g2 c |
}
